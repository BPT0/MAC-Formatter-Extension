{
  "manifest_version": 3,
  "name": "MAC Formatter and Replacer",
  "version": "1.0.0",
  "minimum_chrome_version": "102",
  "description": "Reads MAC addresses from pasted images on your PC (no upload) and formats selected text, then copies in any format.",
  "permissions": ["activeTab", "contextMenus", "clipboardWrite", "scripting", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "MAC Formatter"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
